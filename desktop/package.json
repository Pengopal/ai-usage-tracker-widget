{
  "name": "ai-usage-tracker-widget",
  "productName": "Pengopal AI Usage Tracker",
  "version": "1.4.0",
  "description": "Compact always-on-top Windows widget showing your live Claude, ChatGPT and Grok usage limits.",
  "main": "src/main.js",
  "author": "Muhammad Furqan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pengopal/ai-usage-tracker-widget.git"
  },
  "scripts": {
    "copy-core": "node scripts/copy-core.js",
    "start": "npm run copy-core && electron .",
    "test": "npm run copy-core && node --test \"test/*.test.js\"",
    "build": "npm run copy-core && electron-builder --win",
    "build:portable": "npm run copy-core && electron-builder --win portable",
    "release": "npm run copy-core && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.mufurqan.aiusagetracker",
    "productName": "Pengopal AI Usage Tracker",
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/@openai/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/@openai/codex-win32-${arch}",
        "to": "codex",
        "filter": ["vendor/*/bin/codex.exe"]
      },
      {
        "from": "build",
        "to": "codex",
        "filter": ["codex-*.txt"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Pengopal",
        "repo": "ai-usage-tracker-widget",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "src/assets/app-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "installerIcon": "src/assets/app-icon.ico",
      "uninstallerIcon": "src/assets/app-icon.ico",
      "artifactName": "AI-Usage-Tracker-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pengopal AI Usage Tracker"
    },
    "portable": {
      "artifactName": "AI-Usage-Tracker-Portable-${version}.${ext}"
    }
  },
  "optionalDependencies": {
    "@openai/codex-win32-arm64": "npm:@openai/codex@0.172.0-win32-arm64",
    "@openai/codex-win32-x64": "npm:@openai/codex@0.172.0-win32-x64"
  }
}
